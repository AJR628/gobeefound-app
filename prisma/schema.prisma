// GoBeeFound — §17.2 as amended by docs/SPEC-V4-SCOPE-AMENDMENT.md. The model list is a CLOSED,
// authorized set enforced by tests/guardrails/schema.test.ts. See AGENTS.md §17.1 before adding anything.

generator client {
  provider      = "prisma-client-js"
  // "native" for local dev; rhel-openssl-3.0.x for Netlify Functions (§16.1)
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- enums ----------

enum AuthProvider {
  email
  google
}

enum Trade {
  handyman
  cleaning
  landscaping
  licensed_trade
  mobile_service
  beauty
  photography
  food
  pet_services
  other
}

enum ServiceAreaType {
  atCustomer
  atMyLocation
  both
}

enum BusinessStage {
  launching
  launched
}

enum YesNoUnsure {
  yes
  no
  unsure
}

enum PreferredContact {
  call
  text
  form
  any
}

enum ProvenanceSource {
  owner_entered
  generated_approved
}

enum ConfirmedVia {
  task_completion
  baseline_confirmation
  manual_recheck
}

enum AssetType {
  website
  gbp
  facebook
  instagram
  booking
  other
}

// ONE state column (§5.3). `connected` is reserved and unreachable in V1.
enum ConnectionState {
  declared
  owner_verified
  connected
}

enum TaskStatus {
  not_started
  saved_for_later
  complete
  skipped
  awaiting_verification
}

enum SkipReason {
  already_done
  not_doing
  later
}

enum ToolType {
  website_copy
  descriptions
  review_requests
  seo_meta
  gbp_kit
}

enum DecisionContext {
  task_skip
  generator_edit
  service_offer
  confirmation
}

enum DecisionOutcome {
  accepted
  rejected
  deferred
  ignored
}

enum Product {
  launch
}

enum PurchaseStatus {
  pending
  paid
  refunded
}

enum ServicePlacement {
  task_3_1
  task_3_4
  home_footer
  your_business_footer
}

enum ServiceType {
  website_build
}

// ---------- V4 §E — AI usage and allowance ----------

/**
 * What kind of AI work a call is. Drives the allowance bucket and cost reporting.
 */
enum AiOperationClass {
  website_copy
  descriptions
  review_requests
  section_rewrite
  seo_meta
  gbp_asset
  gbp_kit
  site_draft
  logo_image
}

/**
 * The customer-facing budgets. builds = full website drafts; edits = everything small; logos = AI logo tries.
 */
enum AiBucket {
  builds
  edits
  logos
  managed_edits
}

enum AiUsageOutcome {
  pending
  ok
  claims_rejected
  contact_rejected
  error
}

enum AiAllowanceSource {
  launch_grant
  operator
  managed_period
  purchase
}

// ---------- models (11 V1 + V4, see AGENTS.md §17.1) ----------

model User {
  id           String       @id @db.Uuid // mirrors the Supabase Auth user id
  email        String       @unique
  authProvider AuthProvider
  createdAt    DateTime     @default(now())
  lastSeenAt   DateTime     @default(now())

  business  Business?
  purchases Purchase[]
}

model Business {
  id              String          @id @default(uuid()) @db.Uuid
  ownerId         String          @unique @db.Uuid // one business per user in V1
  trade           Trade
  city            String
  state           String // 2-letter US code, from onboarding Q3. Never inferred, no default.
  serviceAreaType ServiceAreaType
  alreadyServing  Boolean
  stage           BusinessStage   @default(launching)
  launchedAt      DateTime?
  createdAt       DateTime        @default(now())

  owner            User                    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  onboarding       OnboardingAnswers?
  profile          BusinessProfile?
  provenance       FieldProvenance[]
  assets           ConnectedAsset[]
  taskStates       TaskState[]
  generatedContent GeneratedContent[]
  decisions        Decision[]
  serviceLeads     ServiceLead[]
  aiUsage          AiUsage[]
  aiAllowance      AiAllowance?
  aiAdjustments    AiAllowanceAdjustment[]
}

model OnboardingAnswers {
  businessId String      @id @db.Uuid
  hasDomain  YesNoUnsure @default(unsure)
  hasWebsite YesNoUnsure @default(unsure)
  hasEmail   YesNoUnsure @default(unsure)
  hasPhone   YesNoUnsure @default(unsure)
  hasGBP     YesNoUnsure @default(unsure)
  hasSocial  YesNoUnsure @default(unsure)
  hasReviews YesNoUnsure @default(unsure)
  answeredAt DateTime    @default(now())
  revisedAt  DateTime?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model BusinessProfile {
  businessId String @id @db.Uuid

  // identity
  displayName   String // seeded from onboarding Q1
  legalName     String?
  phone         String?
  email         String?
  streetAddress String? // captured by task 4.3 only when hideAddress = false
  hideAddress   Boolean @default(false)
  serviceAreas  Json    @default("[]") // string[]
  hours         Json? // { mon: {open, close} | "closed", ... }
  timezone      String? // IANA. NO DEFAULT. Set only when the owner confirms at task 1.5.

  // offer
  services        Json    @default("[]") // [{ name, description? }]
  pricingApproach String?
  idealCustomer   String?
  differentiators Json? // string[]

  // brand
  logoUrl          String? // Supabase Storage path (the single file-storage exception)
  brandColors      Json? // { primary, secondary }
  shortDescription String?
  gbpDescription   String?
  longDescription  String?

  // web
  domain          String?
  pageTitle       String?
  metaDescription String?

  // reputation
  reviewLink String?

  // operations
  preferredContact   PreferredContact?
  responseCommitment String?

  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model FieldProvenance {
  id              String           @id @default(uuid()) @db.Uuid
  businessId      String           @db.Uuid
  fieldKey        String // matches a BusinessProfile column; Surface-Map-tracked fields only
  source          ProvenanceSource
  setAt           DateTime         @default(now())
  lastConfirmedAt DateTime?
  confirmedVia    ConfirmedVia?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, fieldKey])
}

model ConnectedAsset {
  id              String          @id @default(uuid()) @db.Uuid
  businessId      String          @db.Uuid
  type            AssetType
  url             String
  label           String?
  connectionState ConnectionState @default(declared)
  verifiedAt      DateTime?
  isPrimary       Boolean         @default(true)
  removedAt       DateTime? // soft delete
  createdAt       DateTime        @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, type])
}

model TaskState {
  id          String      @id @default(uuid()) @db.Uuid
  businessId  String      @db.Uuid
  taskId      String // content string, NOT a foreign key
  status      TaskStatus  @default(not_started)
  skipReason  SkipReason?
  notes       String?
  completedAt DateTime?
  updatedAt   DateTime    @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, taskId])
}

model GeneratedContent {
  id            String   @id @default(uuid()) @db.Uuid
  businessId    String   @db.Uuid
  toolType      ToolType
  inputSnapshot Json
  output        Json // never overwritten
  editedOutput  Json?
  wasEdited     Boolean  @default(false)
  model         String? // V4 — resolved provider model id
  promptVersion String? // V4 — PROMPT_VERSION at generation time
  aiUsageId     String?  @db.Uuid // V4 — the ledger row that paid for this
  createdAt     DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
}

/**
 * V4 §E — append-only ledger: ONE row per AI attempt, including failures. Created `pending` BEFORE the
 * model is called (the unique idempotency key makes a concurrent duplicate fail closed), finalized after.
 * Cost and token fields live here, never on the allowance row the UI reads. Server-only writes.
 */
model AiUsage {
  id                  String           @id @default(uuid()) @db.Uuid
  businessId          String           @db.Uuid
  generationId        String           @unique @db.Uuid // our correlation id; returned to the owner as a support reference
  idempotencyKey      String // client-minted per intent, not per attempt
  operation           AiOperationClass
  bucket              AiBucket
  outcome             AiUsageOutcome   @default(pending)
  errorKind           String?
  consumed            Boolean          @default(false) // true = counted against the allowance
  provider            String?
  model               String?
  promptVersion       String?
  inputTokens         Int?
  outputTokens        Int?
  cachedTokens        Int?
  reasoningTokens     Int?
  estimatedCostMicros Int? // USD micro-dollars from the server-side price table; null when the model is unpriced
  durationMs          Int?
  attempts            Int?
  providerRequestId   String?
  platformRequestId   String? // x-nf-request-id
  generatedContentId  String?          @db.Uuid
  createdAt           DateTime         @default(now())
  finishedAt          DateTime?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, idempotencyKey])
  @@index([businessId, createdAt])
  @@index([createdAt])
}

/**
 * V4 §E — per-business budgets. Limits are the EFFECTIVE limits (operator-adjustable via
 * AiAllowanceAdjustment). Reservation is a single conditional UPDATE, so concurrent requests cannot
 * exceed a limit. The owner may read this row; only the server writes it. No cost or token fields here.
 */
model AiAllowance {
  businessId         String    @id @db.Uuid
  buildsLimit        Int       @default(5)
  buildsUsed         Int       @default(0)
  editsLimit         Int       @default(40)
  editsUsed          Int       @default(0)
  logosLimit         Int       @default(3)
  logosUsed          Int       @default(0)
  managedEditsLimit  Int       @default(10) // per Managed billing month (V4 §E); reset on invoice.paid
  managedEditsUsed   Int       @default(0)
  managedPeriodStart DateTime?
  hourlyLimit        Int       @default(20) // short anti-abuse throttle across all buckets
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  business    Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  adjustments AiAllowanceAdjustment[]
}

/**
 * V4 §E — audit trail for every limit change (operator runbook today; purchasable packs later, not in this release).
 */
model AiAllowanceAdjustment {
  id         String            @id @default(uuid()) @db.Uuid
  businessId String            @db.Uuid
  bucket     AiBucket
  delta      Int
  source     AiAllowanceSource
  reason     String?
  createdAt  DateTime          @default(now())

  business  Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  allowance AiAllowance @relation(fields: [businessId], references: [businessId], onDelete: Cascade, map: "AiAllowanceAdjustment_allowance_fkey")

  @@index([businessId, createdAt])
}

model Decision {
  id             String          @id @default(uuid()) @db.Uuid
  businessId     String          @db.Uuid
  context        DecisionContext
  contextId      String
  proposedAction String
  outcome        DecisionOutcome
  reason         String?
  createdAt      DateTime        @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Purchase {
  id                    String         @id @default(uuid()) @db.Uuid
  userId                String?        @db.Uuid // nulled on account deletion (§20.6)
  stripeSessionId       String         @unique
  stripePaymentIntentId String?
  product               Product        @default(launch)
  amountCents           Int // 7900 or 16900 — the credit always derives from this
  status                PurchaseStatus @default(pending)
  creditExpiresAt       DateTime? // paidAt + 90 days
  creditRedeemedAt      DateTime? // set manually via runbook (§15.5)
  createdAt             DateTime       @default(now())
  paidAt                DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model ServiceLead {
  id          String           @id @default(uuid()) @db.Uuid
  businessId  String           @db.Uuid
  placement   ServicePlacement
  serviceType ServiceType      @default(website_build)
  createdAt   DateTime         @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}
