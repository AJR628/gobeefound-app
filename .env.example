# Every variable the application reads. Add a variable here in the same commit that introduces it.
# Server-only secrets NEVER use the NEXT_PUBLIC_ prefix.
#
# ONE repository, TWO Netlify sites (V4 §A11):
#   app    — app.gobeefound.com   SITE_ROLE=app    all variables below
#   public — sites.gobeefound.com SITE_ROLE=public ONLY: DATABASE_URL_PUBLIC, NEXT_PUBLIC_SUPABASE_URL,
#            PUBLIC_SITE_HOST, RESEND_API_KEY (contact relay), PUBLIC_FORWARD_SECRET. No Stripe, no OpenAI,
#            no service-role key, no app database URL.

SITE_ROLE=app

# --- Database (Prisma → Supabase Postgres) ---
DATABASE_URL=
DIRECT_URL=
# Read-only role for the PUBLIC site only (see supabase/rls.sql). Required when SITE_ROLE=public.
DATABASE_URL_PUBLIC=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_LOGO_BUCKET=logos
SUPABASE_PUBLIC_ASSETS_BUCKET=site-assets

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Launch (one-time)
STRIPE_PRICE_ID_LAUNCH_STANDARD=
STRIPE_PRICE_ID_LAUNCH_FOUNDING=
LAUNCH_ACTIVE_PRICE=founding
# Managed (the ONLY recurring product, V4 §F): a $19/month recurring price
STRIPE_PRICE_ID_MANAGED_MONTHLY=

# --- Email / analytics ---
RESEND_API_KEY=
SUPPORT_EMAIL=
NEXT_PUBLIC_POSTHOG_KEY=

# --- AI provider (V4 §J). Server-only. ---
# openai (default) | anthropic (legacy rollback path for ONE release; removed with @anthropic-ai/sdk)
AI_PROVIDER=openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Model ids are server-controlled and never client-selectable. Defaults are compiled in; override here.
OPENAI_MODEL_ROUTINE=gpt-5.6-luna
OPENAI_MODEL_SITE=gpt-5.6-sol
OPENAI_MODEL_IMAGE=gpt-image-1-mini
# Leave OPENAI_BASE_URL UNSET. The app pins https://api.openai.com/v1 explicitly so a platform-injected
# gateway URL can never silently reroute (and re-bill) traffic.

# --- Public sites & domains (V4 §F/§I) ---
PUBLIC_SITE_HOST=sites.gobeefound.com
NEXT_PUBLIC_SITES_URL=https://sites.gobeefound.com
# Netlify's apex load-balancer IP for founding-cohort custom domains (A record for @)
PUBLIC_ORIGIN_APEX_IP=75.2.60.5
# Netlify API (app site only): purge the public site's cache by tag; founding-cohort domain aliases
NETLIFY_API_TOKEN=
NETLIFY_PUBLIC_SITE_ID=
# Shared secret for the Phase 7 hostname layer to forward the original Host header. Unset = not trusted.
PUBLIC_FORWARD_SECRET=

# --- URLs ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MARKETING_URL=https://gobeefound.com
